# Example environment file – copy to .env and fill in real values
# Do NOT commit .env to source control.

# ── Inference endpoints ──────────────────────────────────────────────────────
INFERENCE_URL_CONFIDENTIAL=http://inference-service-a:8080/v1/chat/completions
INFERENCE_URL_INTERNAL=http://inference-service-b:8080/v1/chat/completions
INFERENCE_URL_PUBLIC=http://inference-service-c:8080/v1/chat/completions
INFERENCE_TIMEOUT_SECONDS=60.0
INFERENCE_VERIFY_SSL=true

# ── Authentication ───────────────────────────────────────────────────────────
# Comma-separated list of accepted API keys (leave empty to disable auth)
API_KEYS=
# Mapping of keys to roles: key1:admin,key2:trusted
API_KEY_ROLES=

# ── Anonymisation ────────────────────────────────────────────────────────────
ANONYMIZER_ENABLED=true
# JSON list of roles that may skip anonymisation
ANONYMIZATION_SKIP_ALLOWED_ROLES=["admin","trusted"]

# ── Classification ────────────────────────────────────────────────────────────
CLASSIFIER_SCORE_THRESHOLD=0.5
CLASSIFIER_LANGUAGE=en

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Set to your Alloy / OTEL collector GRPC endpoint to enable telemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_SERVICE_NAME=inference-router

# ── Application ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
